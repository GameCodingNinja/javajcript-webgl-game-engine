<?xml version="1.0"?>
<strategy defaultGroup="(level_1)" defaultCamera="buildingsCamera">

    <object>
        <position z="-60"/>
    </object>

    <node name="explode">

        <sprite>
            <scriptList>
                <script explode="Explode_animation"/>
            </scriptList>
        </sprite>

    </node>

    <node name="enemy00_ship" id="-3">

        <sprite>
            <scale x="0.70" y="0.70" z="1"/>
            <scriptList>
                <script ai_enemy="AI_Enemy00" prepareOnInit="true" ai="true"/>
                <script hit="Enemy00Ship_Hit"/>
                <script die="Enemy00Ship_Die"/>
                <script collision="EnemyShip_CheckForCollideWithPlayer" prepareOnInit="true"/>
            </scriptList>
        </sprite>

    </node>

    <node name="enemy01_ship" id="-4">

        <sprite>
            <scale x="1.08" y="1.08" z="1"/>
            <scriptList>
                <script ai_enemy="AI_Enemy01" prepareOnInit="true" ai="true"/>
                <script hit="Enemy01Ship_Hit"/>
                <script die="Enemy01Ship_Die"/>
                <script collision="EnemyShip_CheckForCollideWithPlayer" prepareOnInit="true"/>
            </scriptList>
        </sprite>

    </node>

    <node name="enemy02_ship" id="-5">

        <sprite>
            <scale x="0.50" y="0.50" z="1"/>
            <scriptList>
                <script ai_enemy="AI_Enemy02" prepareOnInit="true" ai="true"/>
                <script hit="Enemy02Ship_Hit"/>
                <script die="Enemy02Ship_Die"/>
                <script collision="EnemyShip_CheckForCollideWithPlayer" prepareOnInit="true"/>
            </scriptList>
        </sprite>

    </node>

    <node name="boss00_ship" id="-20">

        <!-- Null head node carries the collision; children render in order:
             beam (behind) -> body (front) -> health bar (on top) -->
        <sprite objectName="null_boss00_ship">
            <scale x="1" y="1" z="1"/>
            <scriptList>
                <script ai_boss="AI_Boss00" prepareOnInit="true" ai="true"/>
                <script hit="Boss00Ship_Hit"/>
                <script die="Boss00Ship_Die"/>
                <script collision="EnemyShip_CheckForCollideWithPlayer" prepareOnInit="true"/>
            </scriptList>
        </sprite>

        <node name="boss00_beam">

            <sprite visible="false" useSizeForRadiusCalc="false">
                <position x="0" y="-280" z="0"/>
            </sprite>

        </node>

        <node name="boss00_body">

            <sprite useSizeForRadiusCalc="false"/>

        </node>

        <node name="UIBossHealthBar" type="uiControlNode">

            <uiProgressBar defaultState="inactive" useSizeForRadiusCalc="false">
                <position x="0" y="220" z="0"/>
                <scale x="1" y="1" z="1"/>
                <spriteLst>
                    <sprite objectName="boss00_health_frame"/>
                    <sprite objectName="boss00_health_solid"/>
                </spriteLst>

                <!-- stencil mask -->
                <stencilMask objectName="" spriteIndex="1" />
            </uiProgressBar>

        </node>

        <node name="UIBossHitBar" type="uiControlNode">

            <uiProgressBar defaultState="inactive" useSizeForRadiusCalc="false">
                <position x="0" y="205" z="0"/>
                <scale x="1" y="1" z="1"/>
                <spriteLst>
                    <sprite objectName="boss00_hit_frame"/>
                    <sprite objectName="boss00_hit_solid"/>
                </spriteLst>

                <!-- stencil mask -->
                <stencilMask objectName="" spriteIndex="1" />
            </uiProgressBar>

        </node>

    </node>

    <!-- Not an enemy but the player needs to collide with it to gain health -->
    <node name="health_character" id="-50">

        <sprite>
            <scale x="0.50" y="0.50" z="1"/>
            <scriptList>
                <script animate="HealthCharacter_Animation" prepareOnInit="true"/>
                <script hit="HealthCharacter_Hit"/>
                <script collision="EnemyShip_CheckForCollideWithPlayer" prepareOnInit="true"/>
            </scriptList>
        </sprite>

    </node>

    <!-- Not an enemy but allow the player to better find the health character -->
    <node name="help" id="-51">

        <sprite>
            <scale x="0.50" y="0.50" z="1"/>
        </sprite>

    </node>

</strategy>