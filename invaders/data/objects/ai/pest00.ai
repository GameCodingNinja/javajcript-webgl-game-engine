<?xml version="1.0"?>
<ai>

    <node name="AI_Pest00">

        <head script="AI_Pest00_Head"/>

        <node>

            <composite script="AI_Composite" condition="all_success"/>

            <node>

                <leaf script="AI_Pest00_Descend"/>

            </node>

            <node>

                <decorator script="AI_Decorator" type="repeater"/>

                <node>

                    <composite script="AI_Composite" condition="all_success"/>

                    <node>

                        <leaf script="AI_Pest00_Roam"/>

                    </node>

                    <node>

                        <leaf script="AI_Pest00_Charge"/>

                    </node>

                    <node>

                        <leaf script="AI_Pest00_Spin"/>

                    </node>

                    <node>

                        <leaf script="AI_Pest00_Flee"/>

                    </node>

                </node>

            </node>

        </node>

    </node>

</ai>
